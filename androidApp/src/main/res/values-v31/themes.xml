<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- System splash is color-only (blank icon = splash ground). Logo + StartMusicV3 live in
         LaunchBrandScreen — Android's circular splash mask cannot place a wordmark under a large
         logo, and brandingImage is bottom-only / removed on API 33+. Do not set
         windowSplashScreenIconBackgroundColor (draws a visible icon disc). -->
    <style name="Theme.YMusicV4" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_surface</item>
        <item name="android:windowSplashScreenBackground">@color/app_surface</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
    </style>
</resources>
